# Client-safe Supabase publishable (anon) key only — never a service_role / sb_secret_ key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
# Alias accepted by the client if PUBLISHABLE_KEY is unset:
# VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Server-only. Do not prefix with VITE_ — that would embed the secret in the client bundle.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Optional keyed Carto Dark Matter URL. The public cartocdn rastertiles
# endpoint watermarks tiles ("API KEY REQUIRED") — leave unset to use Esri
# World Dark Gray as the cockpit night chart.
# VITE_CARTO_DARK_TILE_URL=

# Server-only AI captain (never VITE_).
# THALVO_AI_API_KEY=
# THALVO_AI_BASE_URL=
# THALVO_AI_MODEL=
