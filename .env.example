# Client-safe Supabase publishable (anon) key only — never a service_role / sb_secret_ key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Server-only. Do not prefix with VITE_ — that would embed the secret in the client bundle.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Optional Capacitor live-reload (dev devices only). Leave unset for release builds.
# CAPACITOR_LIVE_URL=http://192.168.1.195:8081

# Server-only AI captain (never VITE_).
# THALVO_AI_API_KEY=
# THALVO_AI_BASE_URL=
# THALVO_AI_MODEL=
